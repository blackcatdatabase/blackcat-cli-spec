{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackcatdatabase.github.io/blackcat-cli-spec/schema/blackcat-cli.manifest.schema.json",
  "title": "BlackCat CLI Component Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "cli"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "homepage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "composer_package": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+\\/[a-z0-9_.-]+$"
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoints"],
      "properties": {
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entrypoint" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "summary", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "command": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "type": {
          "type": "string",
          "enum": ["proxy", "builtin"]
        },
        "proxy": { "$ref": "#/$defs/proxy" },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "uniqueItems": true
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "deprecated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "proxy" } },
            "required": ["type"]
          },
          "then": { "required": ["proxy"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "builtin" } },
            "required": ["type"]
          },
          "then": {
            "not": {
              "required": ["proxy"]
            }
          }
        }
      ]
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "script"],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
